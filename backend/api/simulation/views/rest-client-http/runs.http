# Title: Runs API
# Description: API for creating and viewing runs
@base_url = http://localhost:8000/api/v1

###
# @name List Runs
GET {{base_url}}/runs/

###
# @name Retrieve Run
GET {{base_url}}/runs/4

###
# @name Create Run
POST {{base_url}}/runs/
content-type: application/json

{
    "name": "bsf",
    "scenario": 1,
    "agents": 1,
    "runs": 16
}

###
# @name Run Status
GET {{base_url}}/runs/1/status/

###
# @name List Run Outputs
GET {{base_url}}/runs/1/outputs/

###
# @name List Run Exports
GET {{base_url}}/runs/1/exports/
